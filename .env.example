# FraudWatch environment template.
#
#   cp .env.example .env     # then replace every CHANGE_ME with your own random value
#
# This file contains PLACEHOLDERS ONLY. Never commit a real .env (it is gitignored), never paste
# real tokens here, and never print these values in logs or issues.
#
# Generate strong random values, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Compose reads this file only when you pass --env-file explicitly:
#   docker compose --env-file .env -p fraudwatch \
#     -f infra/compose/compose.yaml -f infra/compose/compose.streaming.yaml up -d
#
# Every variable below is referenced by code in this repository unless a comment says otherwise.
# Sources: infra/compose/compose.yaml, infra/compose/compose.streaming.yaml, services/*/app,
# services/common/fwsvc/settings.py, services/controller/app.py, streaming/*, infra/gcp/*.


# =====================================================================================
# 1. Required secrets - Compose refuses to start if any of these five is empty
# =====================================================================================

# PostgreSQL superuser password for the bundled database container.
POSTGRES_PASSWORD=CHANGE_ME_postgres_password

# Shared bearer token for /internal/* routes (controller -> API, probes, drain, active-work).
# In Google Cloud this comes from Secret Manager, not from this file.
INTERNAL_API_TOKEN=CHANGE_ME_internal_api_token

# HMAC secret used to sign visitor demo-session tokens issued by services/api.
SESSION_SIGNING_SECRET=CHANGE_ME_session_signing_secret

# HMAC secret used to sign operator tokens (elevated access to experiments and ops routes).
OPERATOR_AUTH_SECRET=CHANGE_ME_operator_auth_secret

# Salt for hashing client IPs before they are stored for rate limiting. Rotating it resets limits.
CLIENT_HASH_SALT=CHANGE_ME_client_hash_salt


# =====================================================================================
# 2. Database
# =====================================================================================

# Database role and database name created by the postgres container.
POSTGRES_USER=fraudwatch
POSTGRES_DB=fraudwatch

# Host port for local psql access. The container port is always 5432 and is bound to 127.0.0.1.
POSTGRES_HOST_PORT=15432

# Full connection string. Compose builds this from the values above; set it only when you point the
# services at an external database.
# DATABASE_URL=postgresql://fraudwatch:CHANGE_ME_postgres_password@postgres:5432/fraudwatch


# =====================================================================================
# 3. Kafka topics and cluster
# =====================================================================================

# Broker address as seen from inside the Compose network.
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# KRaft cluster id. Changing it after the first start invalidates the existing kafka-data volume.
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qg

# Contract topics. kafka-init creates exactly these.
KAFKA_TRANSACTIONS_TOPIC=fraudwatch.transactions
KAFKA_FLINK_RESULTS_TOPIC=fraudwatch.results.flink
KAFKA_SPARK_RESULTS_TOPIC=fraudwatch.results.spark
KAFKA_FLINK_WINDOWS_TOPIC=fraudwatch.windows.flink
KAFKA_SPARK_WINDOWS_TOPIC=fraudwatch.windows.spark
KAFKA_SPARK_METRICS_TOPIC=fraudwatch.metrics.spark
KAFKA_DLQ_TOPIC=fraudwatch.dlq


# =====================================================================================
# 4. API service (services/api)
# =====================================================================================

# Host interface and port the API is published on locally. On the cloud VM the API is reachable
# only from the Cloud Run egress subnet, never from the public internet.
API_BIND=127.0.0.1
API_HOST_PORT=8000

# Comma-separated browser origins allowed by CORS.
# 5173/5174 are the Vite dev servers; 4173/4174 are `npm run preview:*`, which the Playwright suite uses.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4173,http://localhost:4174,http://127.0.0.1:4173,http://127.0.0.1:4174

# Canonical URLs of the two sites; used for cross-links and for the generated config.js.
LIVE_APP_URL=http://localhost:5173
LAB_APP_URL=http://localhost:5174

# Set to true only when a trusted reverse proxy sets X-Forwarded-For in front of the API.
TRUST_PROXY=false

# Optional operator passphrase hash produced by scripts/hash_passphrase.py.
# Leave empty to disable passphrase login. Never store the plaintext passphrase in this file.
OPERATOR_PASSPHRASE_HASH=

# Internal service URLs (Compose DNS names).
GENERATOR_URL=http://generator:8002
SCORING_SERVICE_URL=http://scoring:8001
FLINK_REST_URL=http://flink-jobmanager:8081

# Experiment runner (services/ops-agent). It runs the queued experiments and starts/stops Spark.
OPS_AGENT_URL=http://ops-agent:8003

# How often the agent looks for a queued experiment, and how long an experiment may stay 'running'
# before it is assumed to belong to an agent that died and is failed so the queue cannot wedge.
OPS_AGENT_POLL_SECONDS=3
OPS_AGENT_STALE_MINUTES=90

# The group that owns /var/run/docker.sock on this host; the agent needs it to start and stop the
# Spark container and to inject TaskManager faults. Docker Desktop: 0. Linux host (and the GCP VM):
# `getent group docker | cut -d: -f3`. Wrong value = Docker unreachable, reported by /healthz.
DOCKER_GID=0

# Out-of-orderness the streaming jobs allow, reported with late-event experiments. Leave empty and
# the experiment records the bound as null rather than guessing one.
WATERMARK_BOUND_MS=

# Session and token lifetimes (seconds) and per-client session creation cap.
SESSION_TTL_S=86400
VIEW_TOKEN_TTL_S=604800
OPERATOR_TOKEN_TTL_S=28800
SESSIONS_PER_CLIENT_PER_HOUR=10

# Server-sent events limits.
SSE_POLL_SECONDS=0.5
SSE_MAX_SECONDS=300
SSE_MAX_STREAMS=200

# Database pool size for the API.
API_DB_POOL_MAX=12

# Structured log retention in the database.
LOG_RETENTION_MS=604800000
LOG_MAX_ROWS=200000
STREAM_LOG_RETENTION_MS=3600000

# Environment label recorded on log rows and evidence exports.
FRAUDWATCH_ENV=local
APP_ENV=production

# Log verbosity for every Python service.
LOG_LEVEL=INFO


# =====================================================================================
# 5. Demo and experiment caps (public demo safety limits)
# =====================================================================================

# Per visitor demo session.
DEMO_MAX_EVENTS_PER_SESSION=5000
DEMO_MAX_EVENTS_PER_SECOND=50

# Operator-run experiments.
EXPERIMENT_MAX_EVENTS_PER_SECOND=1000
EXPERIMENT_QUEUE_MAX=5
MAX_CONCURRENT_BENCHMARKS=1
OPERATOR_MAX_EVENTS_PER_RUN=200000

# Generator-wide ceilings across all concurrent runs.
GENERATOR_MAX_TOTAL_EPS=1200
GENERATOR_MAX_ACTIVE_RUNS=25


# =====================================================================================
# 6. Scoring service and model artifact
# =====================================================================================

# Directory holding model.joblib, metadata.json and evaluation.json inside the scoring container.
MODEL_ARTIFACT_PATH=/models/fw-ieee-stream-1.1.0

# Model version string reported by the API. Keep it consistent with the artifact above.
MODEL_VERSION=fw-ieee-stream-1.1.0

# Uvicorn worker count for the scoring service.
SCORING_WORKERS=2

# IEEE-CIS replay pack used by the generator. The pack is gitignored (Kaggle-derived row data);
# build it with: cd ml && uv run python training/build_replay_pack.py
REPLAY_PACK_DIR=/models/replay/ieee-test-replay-1.0


# =====================================================================================
# 7. Result consumer
# =====================================================================================

RESULT_CONSUMER_GROUP_ID=fw-result-consumer-v1
RESULT_CONSUMER_BATCH_MAX=500
RESULT_CONSUMER_BATCH_WAIT_S=0.05


# =====================================================================================
# 8. Apache Flink (infra/compose/compose.streaming.yaml, streaming/flink)
# =====================================================================================

# Job parallelism. The task manager provides 2 slots by default, so keep this <= 2 locally.
FLINK_PARALLELISM=2

# Kafka consumer group for the Flink source. Change it to replay a topic from scratch.
FLINK_GROUP_ID=fw-flink-v1

# Keyed-state TTL in hours.
FLINK_STATE_TTL_HOURS=72

# Submitter behaviour: "once" submits and exits; "watch" re-submits after a JobManager restart.
FLINK_SUBMITTER_MODE=once
FLINK_SUBMITTER_INTERVAL_S=30
FLINK_SUBMITTER_WAIT_S=300

# Explicit savepoint/checkpoint path to restore from. Empty means: restore from the newest complete
# retained checkpoint found under /opt/flink/checkpoints, else start fresh.
FLINK_RESTORE_PATH=

# How many old checkpoint job directories the submitter keeps before pruning.
FLINK_KEEP_CHECKPOINT_JOB_DIRS=3

# Optional label written onto every result record produced by this job launch.
FLINK_RUN_LABEL=

# Flink Web UI / REST host port (bound to 127.0.0.1). Job submission through the UI is disabled.
FLINK_UI_HOST_PORT=8081


# =====================================================================================
# 9. Apache Spark (Compose profile "spark")
# =====================================================================================

# Micro-batch trigger. Also reported by the API as the Spark configuration in use.
SPARK_TRIGGER_INTERVAL=1 second

# Label distinguishing this Spark launch's records and its checkpoint directory.
SPARK_RUN_LABEL=default

# Checkpoint location. Empty means /opt/spark-checkpoints/<label>.
SPARK_CHECKPOINT_URI=

# Where the Kafka source starts: "latest", "earliest", or an explicit offsets JSON.
SPARK_STARTING_OFFSETS=latest

# Start from a wall-clock timestamp instead (epoch ms). Overrides SPARK_STARTING_OFFSETS when set.
SPARK_STARTING_TIMESTAMP_MS=

# Restrict the job to specific demo sessions or runs (comma lists). Empty means process everything.
SPARK_FILTER_SESSION_IDS=
SPARK_FILTER_RUN_IDS=

# Driver memory for the local[2] Spark job, and the Spark UI host port (bound to 127.0.0.1).
SPARK_DRIVER_MEMORY=1400m
SPARK_UI_HOST_PORT=4040


# =====================================================================================
# 10. Assistant (optional). Provider order: Groq -> Gemini -> OpenAI -> deterministic fallback.
#     With no keys set, the assistant still answers, using the deterministic fallback.
# =====================================================================================

AI_PROVIDER=groq
AI_FALLBACK_ENABLED=true
AI_MAX_OUTPUT_TOKENS=600
AI_TIMEOUT_SECONDS=20
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4.1-mini

# API keys. Leave empty unless you intend to call these providers. Never commit real keys.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=


# =====================================================================================
# 11. Container images
# =====================================================================================

IMAGE_PREFIX=fraudwatch
IMAGE_TAG=1.0.0


# =====================================================================================
# 12. Google Cloud lifecycle controller (services/controller, infra/gcp)
#     These are set on the Cloud Run service by infra/gcp/04-deploy-controller.sh. They are listed
#     here so the full configuration is visible in one place; they have no effect locally.
# =====================================================================================

GCP_PROJECT_ID=fraudwatch-508912
GCP_REGION=asia-south1

# Compute Engine instance the controller starts and stops.
PIPELINE_VM_NAME=fraudwatch-pipeline
PIPELINE_VM_ZONE=asia-south1-a

# API port reached on the VM's internal IP through Direct VPC egress.
PIPELINE_API_PORT=8000

# Master switch for wake-on-visit. Set to false to keep the VM asleep regardless of traffic.
AUTO_WAKE_ENABLED=true

# One bounded automatic demo run per browser session on the websites.
# NOTE: these two are documented in docs/gcp-deployment.md but are not referenced by any code in
# this repository yet.
AUTO_DEMO_ENABLED=true
AUTO_DEMO_MAX_EVENTS=100

# Stop the VM after this many minutes without meaningful activity (POST/PATCH calls, ensure-ready,
# activity pings). Passive GET polling does not count.
PIPELINE_IDLE_TIMEOUT_MINUTES=45

# Deadline for the whole wake sequence before the state machine reports "failed".
PIPELINE_STARTUP_TIMEOUT_SECONDS=600

# How long shutdown waits for in-flight results to be persisted before stopping the VM anyway.
PIPELINE_DRAIN_TIMEOUT_SECONDS=180

# The VM will not be stopped before it has been up this long.
PIPELINE_MIN_UPTIME_MINUTES=10

# Spend guards: wakes per rolling day, VM hours per rolling day, operator keep-awake ceiling,
# and the cooldown after a failed start.
PIPELINE_MAX_WAKES_PER_DAY=24
PIPELINE_MAX_UPTIME_HOURS_PER_DAY=12
PIPELINE_KEEP_AWAKE_MAX_MINUTES=180
PIPELINE_FAILED_RETRY_COOLDOWN_SECONDS=60

# Firestore collection holding lifecycle state, locks, activity and history (document "pipeline").
CONTROL_STATE_COLLECTION=fraudwatch-runtime

# Cloud Tasks queue carrying the step and idle-check timers.
CONTROL_TASK_QUEUE=fraudwatch-lifecycle

# Public URL of the controller itself (OIDC audience for its own task callbacks) and the service
# account Cloud Tasks mints OIDC tokens for. Set by the deploy script.
CONTROLLER_URL=
TASKS_SERVICE_ACCOUNT=

# Browser runtime config injected into the static site containers at start (infra/gcp/web).
# API_BASE_URL points at the controller's /api/v1 proxy, not at the VM.
API_BASE_URL=
CONTROL_URL=


# =====================================================================================
# 13. Frontend build-time variables (Vite). Only needed for a local dev server or a custom build;
#     deployed containers get these at runtime through config.js instead.
# =====================================================================================

VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_LIVE_APP_URL=http://localhost:5173
VITE_LAB_APP_URL=http://localhost:5174
VITE_CONTROL_URL=
