{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "types": [],
    "paths": {
      "@fraudwatch/contracts": ["./packages/contracts/src/index.ts"],
      "@fraudwatch/contracts/react": ["./packages/contracts/src/react.ts"],
      "@fraudwatch/ui": ["./packages/ui/src/index.ts"]
    }
  }
}
